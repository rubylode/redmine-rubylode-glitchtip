#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs the throwaway Redmine this plugin is developed and reviewed in, with a fake GlitchTip next to it.
#
#   ruby bin/demo up               start both, run the plugin migrations, load the demo data (once; again changes nothing)
#   ruby bin/demo restart          restart Redmine, to pick up a change to the plugin (it runs in production mode)
#   ruby bin/demo scenario NAME    switch what the fake GlitchTip reports: several, none, unavailable or hostile
#   ruby bin/demo down             stop it, keep the data
#   ruby bin/demo reset            stop it and wipe the data
#
# Redmine is on http://localhost:3014 (admin / admin, or sam.rivera / demo-password-1), the fake GlitchTip on port 9114.
require "net/http"

ROOT = File.expand_path("..", __dir__)
PORT = 3014
FAKE_PORT = 9114
READY_SECONDS = 240
SEED_SCRIPT = "plugins/redmine_rubylode_glitchtip/script/seed_demo.rb"
SCENARIOS = %w[several none unavailable hostile].freeze

def compose(*arguments)
  system("docker", "compose", *arguments, chdir: ROOT) || abort("docker compose #{arguments.join(' ')} failed")
end

def wait_until_ready
  uri = URI("http://localhost:#{PORT}/login")
  deadline = Time.now + READY_SECONDS
  loop do
    begin
      return puts("Redmine is up at http://localhost:#{PORT}") if Net::HTTP.get_response(uri).code == "200"
    rescue SystemCallError, EOFError, Net::ReadTimeout
      nil
    end
    abort("Redmine did not answer within #{READY_SECONDS} seconds") if Time.now > deadline
    sleep 3
  end
end

def switch_scenario(name)
  abort("Scenario must be one of: #{SCENARIOS.join(', ')}") unless SCENARIOS.include?(name)
  puts Net::HTTP.post(URI("http://localhost:#{FAKE_PORT}/__scenario/#{name}"), "").body
end

case ARGV.first
when "up"
  compose("up", "-d", "redmine")
  wait_until_ready
  compose("exec", "-T", "redmine", "bundle", "exec", "rake", "redmine:plugins:migrate")
  compose("exec", "-T", "redmine", "bin/rails", "runner", SEED_SCRIPT)
when "restart"
  compose("restart", "redmine")
  wait_until_ready
when "scenario"
  switch_scenario(ARGV[1].to_s)
when "down"
  compose("down")
when "reset"
  compose("down", "-v")
else
  abort(File.read(__FILE__)[/\A#!.*?\n# frozen.*?\n\n((?:#.*\n)+)/m, 1].to_s.gsub(/^# ?/, ""))
end
