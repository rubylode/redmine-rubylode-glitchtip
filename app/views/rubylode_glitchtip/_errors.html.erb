<%# The errors block. Other plugins can render it: render partial: "rubylode_glitchtip/errors"
    Optional locals: title (replaces the block title), show_title (false hides it), compact (a smaller block
    without project and culprit), inline_stylesheet (true when the page's head is already sent). It draws nothing for a person the
    settings do not allow, and a hint for administrators while the plugin is not set up. Everything GlitchTip supplies
    (titles, culprits, project names) is escaped by ERB; the issue link is built from the saved address and a numeric id. %>
<% configuration = RubylodeGlitchtip::Configuration.current %>
<% if configuration.visible_to?(User.current) %>
  <% stylesheet = stylesheet_link_tag("rubylode_glitchtip", plugin: "redmine_rubylode_glitchtip") %>
  <%# A full page takes the stylesheet in its head; an AJAX render (the wiki preview) or a block drawn after the head has none, so it carries the link itself. %>
  <% if request.xhr? || local_assigns[:inline_stylesheet] %><%= stylesheet %><% else %><% content_for :header_tags, stylesheet %><% end %>
  <% compact = local_assigns.fetch(:compact, false) %>
  <% block_title = local_assigns[:title].presence || configuration.block_title %>
  <% show_title = local_assigns.fetch(:show_title, true) %>
  <% if configuration.configured? %>
    <% report = RubylodeGlitchtip::ErrorsReport.current(configuration).report %>
    <div class="rubylode-glitchtip-errors<%= " is-compact" if compact %>">
      <% if show_title %><h3 class="rubylode-glitchtip-errors-title"><%= block_title %></h3><% end %>
      <p class="rubylode-glitchtip-errors-summary is-<%= report.summary_state.to_s.dasherize %>"><%= report.summary %></p>
      <% if report.unavailable? && User.current.admin? %>
        <p class="rubylode-glitchtip-errors-hint"><%= l("rubylode_glitchtip.hints.reason", reason: report.failure_reason) %></p>
      <% end %>
      <% if report.issues.any? %>
        <table class="list rubylode-glitchtip-errors-table">
          <thead>
            <tr>
              <th><%= l("rubylode_glitchtip.columns.issue") %></th>
              <th class="rubylode-glitchtip-errors-project"><%= l("rubylode_glitchtip.columns.project") %></th>
              <th><%= l("rubylode_glitchtip.columns.level") %></th>
              <th class="rubylode-glitchtip-errors-events"><%= l("rubylode_glitchtip.columns.events") %></th>
              <th class="rubylode-glitchtip-errors-last-seen"><%= l("rubylode_glitchtip.columns.last_seen") %></th>
            </tr>
          </thead>
          <tbody>
            <% report.issues.each do |issue| %>
              <% level = RubylodeGlitchtip::AttentionRule::LEVEL_ORDER.include?(issue.level) ? issue.level : "unknown" %>
              <tr class="rubylode-glitchtip-errors-row is-<%= level %>">
                <td class="rubylode-glitchtip-errors-title-cell">
                  <%= link_to issue.title.presence || issue.short_id, "#{configuration.base_url}/#{ERB::Util.url_encode(configuration.organization_slug)}/issues/#{issue.id}",
                              class: "rubylode-glitchtip-errors-link", title: l("rubylode_glitchtip.open_in_glitchtip"), rel: "noopener noreferrer", target: "_blank" %>
                  <% if issue.culprit.present? %><span class="rubylode-glitchtip-errors-culprit"><%= issue.culprit %></span><% end %>
                </td>
                <td class="rubylode-glitchtip-errors-project"><%= issue.project_name %></td>
                <td class="rubylode-glitchtip-errors-level"><span class="rubylode-glitchtip-errors-dot" aria-hidden="true"></span><%= l("rubylode_glitchtip.levels.#{level}") %></td>
                <td class="rubylode-glitchtip-errors-events"><%= number_with_delimiter(issue.count) %></td>
                <td class="rubylode-glitchtip-errors-last-seen" title="<%= format_time(issue.last_seen) %>"><%= l("rubylode_glitchtip.last_seen_ago", time: time_ago_in_words(issue.last_seen)) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <% if report.hidden_count.positive? %>
          <p class="rubylode-glitchtip-errors-more"><%= l("rubylode_glitchtip.status.more_issues", count: report.hidden_count) %></p>
        <% end %>
      <% end %>
    </div>
  <% elsif User.current.admin? %>
    <div class="rubylode-glitchtip-errors<%= " is-compact" if compact %>">
      <% if show_title %><h3 class="rubylode-glitchtip-errors-title"><%= block_title %></h3><% end %>
      <p class="rubylode-glitchtip-errors-hint">
        <%= l("rubylode_glitchtip.hints.not_configured") %>
        <%= link_to l("rubylode_glitchtip.hints.not_configured_link"), plugin_settings_path(RedmineRubylodeGlitchtip::PLUGIN_ID.to_s) %>
      </p>
    </div>
  <% end %>
<% end %>
