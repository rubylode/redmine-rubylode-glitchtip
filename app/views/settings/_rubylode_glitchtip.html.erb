<% configuration = RubylodeGlitchtip::Settings.new(settings) %>
<% if @validation_errors.present? %>
  <div id="errorExplanation" class="rubylode-glitchtip-settings-errors">
    <ul>
      <% @validation_errors.each do |message| %><li><%= message %></li><% end %>
    </ul>
  </div>
<% end %>
<% scope = "rubylode_glitchtip.settings" %>
<% text_value = ->(key) { settings[key].nil? ? RubylodeGlitchtip::Settings::DEFAULTS[key] : settings[key] } %>
<% chosen_levels = RubylodeGlitchtip::Settings.new("levels" => text_value.call("levels")).levels %>
<% column_options = [[l("#{scope}.column_options.left"), "left"], [l("#{scope}.column_options.right"), "right"]] %>
<%= render partial: "rubylode_glitchtip/status_plugin_notice" %>
<p>
  <label for="settings_base_url"><%= l("#{scope}.base_url.label") %></label>
  <%= text_field_tag "settings[base_url]", text_value.call("base_url"), size: 60, id: "settings_base_url", placeholder: "https://glitchtip.example.com" %>
  <em class="info"><%= l("#{scope}.base_url.hint") %></em>
</p>
<p>
  <label for="settings_organization_slug"><%= l("#{scope}.organization_slug.label") %></label>
  <%= text_field_tag "settings[organization_slug]", text_value.call("organization_slug"), size: 30, id: "settings_organization_slug", placeholder: "my-organization" %>
  <em class="info"><%= l("#{scope}.organization_slug.hint") %></em>
</p>
<p>
  <label for="settings_token_environment_variable"><%= l("#{scope}.token_environment_variable.label") %></label>
  <%= text_field_tag "settings[token_environment_variable]", text_value.call("token_environment_variable"), size: 30, id: "settings_token_environment_variable" %>
  <em class="info">
    <%= l("#{scope}.token_environment_variable.hint") %>
    <strong><%= configuration.token.empty? ? l("#{scope}.token_environment_variable.not_set") : l("#{scope}.token_environment_variable.set") %></strong>
  </em>
</p>
<p>
  <label for="settings_allowed_hosts"><%= l("#{scope}.allowed_hosts.label") %></label>
  <%= text_field_tag "settings[allowed_hosts]", text_value.call("allowed_hosts"), size: 60, id: "settings_allowed_hosts" %>
  <em class="info"><%= l("#{scope}.allowed_hosts.hint") %></em>
</p>
<p>
  <label for="settings_allow_plain_http"><%= l("#{scope}.allow_plain_http.label") %></label>
  <%= hidden_field_tag "settings[allow_plain_http]", "0", id: nil %>
  <%= check_box_tag "settings[allow_plain_http]", "1", text_value.call("allow_plain_http").to_s == "1", id: "settings_allow_plain_http" %>
  <em class="info"><%= l("#{scope}.allow_plain_http.hint") %></em>
</p>
<p>
  <label for="settings_look_back_hours"><%= l("#{scope}.look_back_hours.label") %></label>
  <%= number_field_tag "settings[look_back_hours]", text_value.call("look_back_hours"), min: 1, size: 6, id: "settings_look_back_hours" %>
  <em class="info"><%= l("#{scope}.look_back_hours.hint") %></em>
</p>
<p>
  <label for="settings_minimum_event_count"><%= l("#{scope}.minimum_event_count.label") %></label>
  <%= number_field_tag "settings[minimum_event_count]", text_value.call("minimum_event_count"), min: 1, size: 6, id: "settings_minimum_event_count" %>
  <em class="info"><%= l("#{scope}.minimum_event_count.hint") %></em>
</p>
<p>
  <label><%= l("#{scope}.levels.label") %></label>
  <%= hidden_field_tag "settings[levels][]", "", id: nil %>
  <% RubylodeGlitchtip::Settings::LEVELS.each do |level| %>
    <label class="inline"><%= check_box_tag "settings[levels][]", level, chosen_levels.include?(level), id: "settings_levels_#{level}" %> <%= l("rubylode_glitchtip.levels.#{level}") %></label>
  <% end %>
</p>
<p>
  <label for="settings_maximum_rows"><%= l("#{scope}.maximum_rows.label") %></label>
  <%= number_field_tag "settings[maximum_rows]", text_value.call("maximum_rows"), min: 1, max: 100, size: 6, id: "settings_maximum_rows" %>
  <em class="info"><%= l("#{scope}.maximum_rows.hint") %></em>
</p>
<p>
  <label for="settings_project_allow_list"><%= l("#{scope}.project_allow_list.label") %></label>
  <%= text_area_tag "settings[project_allow_list]", text_value.call("project_allow_list"), rows: 3, cols: 60, id: "settings_project_allow_list", placeholder: "web, api" %>
  <em class="info"><%= l("#{scope}.project_allow_list.hint") %></em>
</p>
<p>
  <label for="settings_block_title"><%= l("#{scope}.block_title.label") %></label>
  <%= text_field_tag "settings[block_title]", text_value.call("block_title"), size: 30, id: "settings_block_title" %>
  <em class="info"><%= l("#{scope}.block_title.hint") %></em>
</p>
<p>
  <label for="settings_visibility"><%= l("#{scope}.visibility.label") %></label>
  <%= select_tag "settings[visibility]", options_for_select([[l("#{scope}.visibility.options.logged_in"), "logged_in"], [l("#{scope}.visibility.options.admins"), "admins"]], text_value.call("visibility")), id: "settings_visibility" %>
</p>
<fieldset class="rubylode-glitchtip-placements">
  <legend><%= l("#{scope}.placements.heading") %></legend>
  <p>
    <label for="settings_show_on_welcome_page"><%= l("#{scope}.show_on_welcome_page.label") %></label>
    <%= hidden_field_tag "settings[show_on_welcome_page]", "0", id: nil %>
    <%= check_box_tag "settings[show_on_welcome_page]", "1", text_value.call("show_on_welcome_page").to_s == "1", id: "settings_show_on_welcome_page" %>
    <label class="inline" for="settings_welcome_page_column"><%= l("#{scope}.welcome_page_column.label") %></label>
    <%= select_tag "settings[welcome_page_column]", options_for_select(column_options, text_value.call("welcome_page_column")), id: "settings_welcome_page_column" %>
    <em class="info"><%= l("#{scope}.show_on_welcome_page.hint") %></em>
  </p>
  <p>
    <label for="settings_show_on_my_page"><%= l("#{scope}.show_on_my_page.label") %></label>
    <%= hidden_field_tag "settings[show_on_my_page]", "0", id: nil %>
    <%= check_box_tag "settings[show_on_my_page]", "1", text_value.call("show_on_my_page").to_s == "1", id: "settings_show_on_my_page" %>
    <em class="info"><%= l("#{scope}.show_on_my_page.hint") %></em>
  </p>
  <p>
    <label for="settings_show_on_project_overview"><%= l("#{scope}.show_on_project_overview.label") %></label>
    <%= hidden_field_tag "settings[show_on_project_overview]", "0", id: nil %>
    <%= check_box_tag "settings[show_on_project_overview]", "1", text_value.call("show_on_project_overview").to_s == "1", id: "settings_show_on_project_overview" %>
    <label class="inline" for="settings_project_overview_column"><%= l("#{scope}.project_overview_column.label") %></label>
    <%= select_tag "settings[project_overview_column]", options_for_select(column_options, text_value.call("project_overview_column")), id: "settings_project_overview_column" %>
    <em class="info"><%= l("#{scope}.show_on_project_overview.hint") %></em>
  </p>
  <p>
    <label for="settings_show_on_matching_pages"><%= l("#{scope}.show_on_matching_pages.label") %></label>
    <%= hidden_field_tag "settings[show_on_matching_pages]", "0", id: nil %>
    <%= check_box_tag "settings[show_on_matching_pages]", "1", text_value.call("show_on_matching_pages").to_s == "1", id: "settings_show_on_matching_pages" %>
    <em class="info"><%= l("#{scope}.show_on_matching_pages.hint") %></em>
  </p>
  <p>
    <label for="settings_matching_page_paths"><%= l("#{scope}.matching_page_paths.label") %></label>
    <%= text_area_tag "settings[matching_page_paths]", text_value.call("matching_page_paths"), rows: 4, cols: 60, id: "settings_matching_page_paths", placeholder: "/issues\n/projects/*/issues" %>
    <em class="info"><%= l("#{scope}.matching_page_paths.hint") %></em>
  </p>
  <% unless RubylodeGlitchtip::Settings.status_plugin_installed? %>
    <p>
      <label for="settings_show_in_top_menu"><%= l("#{scope}.show_in_top_menu.label") %></label>
      <%= hidden_field_tag "settings[show_in_top_menu]", "0", id: nil %>
      <%= check_box_tag "settings[show_in_top_menu]", "1", text_value.call("show_in_top_menu").to_s == "1", id: "settings_show_in_top_menu" %>
      <em class="info"><%= l("#{scope}.show_in_top_menu.hint") %></em>
    </p>
  <% else %>
    <%# The setting is hidden while Rubylode Status is installed; its saved value is sent back so it is not lost. %>
    <%= hidden_field_tag "settings[show_in_top_menu]", text_value.call("show_in_top_menu"), id: nil %>
  <% end %>
</fieldset>
<p>
  <label for="settings_cache_seconds"><%= l("#{scope}.cache_seconds.label") %></label>
  <%= number_field_tag "settings[cache_seconds]", text_value.call("cache_seconds"), min: 0, size: 6, id: "settings_cache_seconds" %>
  <em class="info"><%= l("#{scope}.cache_seconds.hint") %></em>
</p>
<p>
  <label for="settings_failure_cache_seconds"><%= l("#{scope}.failure_cache_seconds.label") %></label>
  <%= number_field_tag "settings[failure_cache_seconds]", text_value.call("failure_cache_seconds"), min: 0, size: 6, id: "settings_failure_cache_seconds" %>
  <em class="info"><%= l("#{scope}.failure_cache_seconds.hint") %></em>
</p>
<p>
  <label for="settings_timeout_seconds"><%= l("#{scope}.timeout_seconds.label") %></label>
  <%= number_field_tag "settings[timeout_seconds]", text_value.call("timeout_seconds"), min: 1, size: 6, id: "settings_timeout_seconds" %>
  <em class="info"><%= l("#{scope}.timeout_seconds.hint") %></em>
</p>

<%= render partial: "rubylode_glitchtip/help" %>
